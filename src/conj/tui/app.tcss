Screen {
    layout: vertical;
}

#top {
    height: 3;
    padding: 0 1;
}

#search {
    width: 1fr;
}

#langbar {
    width: auto;
    padding: 1 0 0 2;
}

#body {
    height: 1fr;
}

#side {
    width: 30;
    border-right: tall $panel;
}

#results {
    height: 1fr;
    border: none;
}

#results:focus {
    background: $boost;
}

#sidehelp {
    height: 1;
    padding: 0 1;
}

#main {
    width: 1fr;
    padding: 0 2;
}

#main:focus {
    background: $boost;
}

QuitScreen {
    align: center middle;
    background: $background 60%;
}

#quit-dialog {
    width: auto;
    height: auto;
    padding: 1 3;
    border: round $accent;
    background: $surface;
}

#welcome {
    padding: 1 2;
}

ParadigmView {
    height: auto;
}

.verb-header {
    padding: 1 0 0 0;
}

.section-title {
    margin: 1 0 0 0;
    text-style: bold;
    color: $accent;
    border-bottom: solid $accent 40%;
}

.tenses {
    height: auto;
    grid-size: 3;
    grid-gutter: 1 2;
    grid-rows: auto;
    padding: 1 0 0 0;
}

.tense {
    height: auto;
}

/* tense selected with `t` (yy copies it); the blank border keeps widths stable */
.tense {
    border-left: blank;
    padding: 0 0 0 1;
}

.tense.selected {
    border-left: thick $accent;
    background: $boost;
}
